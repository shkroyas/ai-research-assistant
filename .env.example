# Copy this file to .env and fill in real values. Never commit .env.

# Order in which LLM providers are tried. If the first fails, the next is used.
LLM_PROVIDERS=bedrock,groq

# --- Amazon Bedrock (Claude) ---
# Credentials come from the standard AWS chain: `aws configure`, AWS_PROFILE,
# or the two access key variables below.
AWS_REGION=us-east-1
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Copy the exact model id (or inference profile id) from the Bedrock console.
BEDROCK_MODEL_ID=anthropic.claude-opus-4-6-v1
# invoke = InvokeModel API (Claude Opus 4.6 and earlier, also newer models)
# mantle = Bedrock Messages API (Claude 4.7 and later only)
BEDROCK_API=invoke

# --- Groq (free tier) ---
# One or more keys, comma separated. On HTTP 429 the next key is used.
GROQ_API_KEYS=gsk_key_one,gsk_key_two,gsk_key_three,gsk_key_four,gsk_key_five
GROQ_MODEL=llama-3.3-70b-versatile

# --- Web search (optional) ---
# Without it the Researcher uses clearly labelled sample data.
TAVILY_API_KEY=tvly-your-key-here

# --- Tuning ---
MAX_SEARCH_RESULTS=5
MAX_REVISIONS=1
LOG_LEVEL=INFO
