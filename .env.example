# Copy this file to .env and fill in real values. Never commit .env.

# Providers offered in the app's model picker. The first one is selected by default.
LLM_PROVIDERS=bedrock,groq

# --- Amazon Bedrock (Claude) ---
# Credentials come from the standard AWS chain: `aws configure`, AWS_PROFILE,
# or the two access key variables below.
AWS_REGION=us-east-1
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Claude Opus 4.6 must be called through an inference profile (us. or global. prefix).
# List yours: aws bedrock list-inference-profiles --region us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1
# invoke = InvokeModel API (Claude Opus 4.6 and earlier, also newer models)
# mantle = Bedrock Messages API (Claude 4.7 and later only)
BEDROCK_API=invoke

# --- Groq (free tier, alternative to Claude) ---
# One or more keys, comma separated. On HTTP 429 the next key is used.
GROQ_API_KEYS=gsk_key_one,gsk_key_two,gsk_key_three,gsk_key_four,gsk_key_five
GROQ_MODEL=openai/gpt-oss-120b

# --- Web search (optional) ---
# Without it the Researcher uses clearly labelled sample data.
TAVILY_API_KEY=tvly-your-key-here

# Read each result page and keep its most relevant passage (respects robots.txt).
SCRAPE_PAGES=true
# Also read PDF reports (slower; first 20 pages, up to 10 MB each)
READ_PDFS=false

# --- Tuning ---
MAX_SEARCH_RESULTS=5
MAX_REVISIONS=1
LOG_LEVEL=INFO
